# Copy to .env and fill in. .env is git-ignored.
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=esg_award
MARIADB_USER=esg
MARIADB_PASSWORD=change-me
MARIADB_PORT=3306
CLAMAV_PORT=3310

# Backend (internal/platform Config). MARIADB_* above are shared with docker-compose.
HTTP_ADDR=:8080
LOG_LEVEL=info
MARIADB_HOST=127.0.0.1
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=esg-ideas
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
CLAMAV_ADDR=127.0.0.1:3310
ADMINS_FILE=./admins.local.json
EVENT_YEAR=2026
# RFC 3339 with an explicit +08:00 offset (ADR 0014); Z is rejected.
EVENT_DEADLINE=2026-12-31T23:59:59+08:00
